# ----------------------------------------------------------------------
# Miniaturas generadas por App\Controllers\Thumb (/img/{carpeta}/{ancho}/...).
# Solo imágenes; nunca se ejecutan scripts aquí.
# ----------------------------------------------------------------------
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

Options -Indexes

# El nombre incluye el de la foto original (único): se guardan un año
<IfModule mod_headers.c>
	Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
