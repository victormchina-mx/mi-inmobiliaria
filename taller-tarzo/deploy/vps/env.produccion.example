# TARZO · producción en VPS
APP_NAME=TarsoHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tarzo.vmch.net
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tarzo
DB_USERNAME=tarzo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Infraestructura: VPS ---
TARZO_NOMBRE=TarsoHub
TARZO_RAZON_SOCIAL=
TARZO_DOMICILIO=
TARZO_TELEFONO=
TARZO_EMAIL=
TARZO_EMAIL_PRIVACIDAD=
TARZO_HOSTING=vps
TARZO_COLA_POR_CRON=false
TARZO_TIEMPO_REAL=reverb
TARZO_HSTS=true
TARZO_URL_RESENA=

# WhatsApp Business (Cloud API). 'desactivado' = avisos por correo.
WHATSAPP_DRIVER=desactivado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

MEDIA_DISK=r2

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tarzo-media
R2_ENDPOINT=https://ID_DE_CUENTA.r2.cloudflarestorage.com
R2_URL=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=tarzo.vmch.net
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Facturación CFDI 4.0 (simulado = sin validez fiscal; facturama = PAC real)
CFDI_DRIVER=simulado
CFDI_AMBIENTE=pruebas
CFDI_USUARIO=
CFDI_PASSWORD=
CFDI_SERIE=A
CFDI_SERIE_NC=NC
CFDI_SERIE_PAGO=P
CFDI_EMISOR_RFC=
CFDI_EMISOR_NOMBRE=
CFDI_EMISOR_REGIMEN=601
CFDI_LUGAR_EXPEDICION=
