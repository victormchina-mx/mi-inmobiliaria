# TARZO · producción en Hostinger compartido
APP_NAME=TARZO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tarzo.vmch.net
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Infraestructura: hosting compartido ---
TARZO_NOMBRE=TARZO
TARZO_RAZON_SOCIAL=
TARZO_DOMICILIO=
TARZO_TELEFONO=
TARZO_EMAIL=
TARZO_EMAIL_PRIVACIDAD=
TARZO_HOSTING=compartido
TARZO_COLA_POR_CRON=true
TARZO_COLA_MAX_SEGUNDOS=50
TARZO_TIEMPO_REAL=polling
TARZO_INTERVALO_POLLING=15s
TARZO_HSTS=true
TARZO_URL_RESENA=

# WhatsApp Business (Cloud API). 'desactivado' = avisos por correo.
WHATSAPP_DRIVER=desactivado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

MEDIA_DISK=media

# Correo de Hostinger (hPanel → Correos)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
