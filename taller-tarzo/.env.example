# ---------------------------------------------------------------
# TARZO · entorno de desarrollo local
# Producción: ver deploy/hostinger-compartido/env.produccion.example
#             y deploy/vps/env.produccion.example
# ---------------------------------------------------------------
APP_NAME=TarsoHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local con SQLite; en producción MySQL/MariaDB.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tarzo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- TARZO: modo de infraestructura (ver config/tarzo.php) ---
TARZO_NOMBRE=TarsoHub
TARZO_RAZON_SOCIAL=
TARZO_DOMICILIO=
TARZO_TELEFONO=
TARZO_EMAIL=
TARZO_EMAIL_PRIVACIDAD=
TARZO_HOSTING=compartido
TARZO_COLA_POR_CRON=true
TARZO_TIEMPO_REAL=polling
TARZO_INTERVALO_POLLING=15s
TARZO_HSTS=false
TARZO_URL_RESENA=

# WhatsApp Business (Cloud API). 'desactivado' = avisos por correo.
WHATSAPP_DRIVER=desactivado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

MEDIA_DISK=media

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="taller@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (solo cuando MEDIA_DISK=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

VITE_APP_NAME="${APP_NAME}"

# Facturación CFDI 4.0 (simulado = sin validez fiscal; facturama = PAC real)
CFDI_DRIVER=simulado
CFDI_AMBIENTE=pruebas
CFDI_USUARIO=
CFDI_PASSWORD=
CFDI_SERIE=A
CFDI_SERIE_NC=NC
CFDI_SERIE_PAGO=P
CFDI_EMISOR_RFC=EKU9003173C9
CFDI_EMISOR_NOMBRE="ESCUELA KEMPER URGATE"
CFDI_EMISOR_REGIMEN=601
CFDI_LUGAR_EXPEDICION=42501
