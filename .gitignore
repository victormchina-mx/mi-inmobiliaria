.env
vendor/
writable/cache/*
writable/logs/*
writable/session/*
writable/uploads/*
writable/debugbar/*
# Las fotos subidas no van al repositorio, pero sí la regla que impide
# ejecutar scripts dentro de la carpeta de subidas
public/uploads/*
!public/uploads/.htaccess
# Miniaturas generadas automáticamente (se regeneran solas si se borran)
public/img/*
!public/img/.htaccess
*.DS_Store

# Respaldos manuales y basura de macOS
*.bak
*.bak-*
*_BackUp*
*_BackUP*
.DS_Store

# Archivos de la plantilla original con credenciales por defecto
01 LOGIN DETAILS*
